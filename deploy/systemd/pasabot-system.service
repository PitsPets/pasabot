# PasaBot server as a system service on a Linux server, running as the low-privilege `pasabot` user
# (runner mode `user`). Installed by `sudo pasabot service install --system`.
# Create the user first: useradd --system --home-dir /var/lib/pasabot --shell /usr/sbin/nologin pasabot
[Unit]
Description=PasaBot server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pasabot
Group=pasabot
ExecStart=@NODE@ @ENTRY@
WorkingDirectory=@ROOT@
Environment=@HOME_ENV@
EnvironmentFile=-@ENV_FILE@
StateDirectory=pasabot
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
UMask=0077
TimeoutStopSec=20
# hardening: the server writes only its own state folder
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@PASABOT_HOME@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
