{
  "name": "@pasabot/provider-gemini",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "pasabot": {
    "kind": "provider",
    "entry": "./dist/index.js",
    "source": "./src/index.ts"
  },
  "dependencies": {
    "@pasabot/core": "workspace:*",
    "@pasabot/provider-acp": "workspace:*"
  },
  "devDependencies": {
    "@pasabot/protocol": "workspace:*"
  }
}
