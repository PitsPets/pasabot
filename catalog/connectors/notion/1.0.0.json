{
  "schema": "pasabot.connector/v1",
  "slug": "notion",
  "name": "Notion",
  "version": "1.0.0",
  "category": "files-notes",
  "summary": "Notion's own hosted MCP server. Sign in with Notion in your browser; nothing runs on this machine.",
  "homepage": "https://www.notion.com",
  "source": "https://developers.notion.com/guides/mcp/get-started-with-mcp",
  "group": "files-notes",
  "popular": true,
  "kind": "mcp-http",
  "mcp": {
    "url": "https://mcp.notion.com/mcp",
    "headers": {
      "Authorization": "Bearer {{secret:oauth_token}}"
    }
  },
  "auth": {
    "type": "oauth2_pkce",
    "oauth": {
      "discover": "mcp",
      "clientIdFrom": "register"
    }
  },
  "network": {
    "allowHosts": []
  },
  "defaultTier": 2,
  "toolClasses": {
    "notion-create-comment": "outbound-message",
    "notion-update-page": "delete",
    "notion-move-pages": "delete"
  }
}
